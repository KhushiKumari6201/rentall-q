# Next.js Application Environment Variables
NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_nextauth_secret_in_production

# Supabase Database & Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Python Agents Microservice URL (Internal HTTP call from Next.js)
AGENTS_SERVICE_URL=http://localhost:8000

# Redis Cache / Queue URL
REDIS_URL=redis://localhost:6379/0

# AI Provider API Keys (Used inside agents-service)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
